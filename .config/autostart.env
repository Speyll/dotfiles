LOG="/tmp/autostart.log"
AUDIO=false
MODE="swaybg-random-online"
#MODE="mpvpaper-online"
THEME_MODE="none" # auto, fixed, none
THEME_NAME="gruvbox-dark-medium"
CURSOR="Kaela-Kovalskia-v2"
WAYBAR_STYLE="notch"

# Local Fallbacks
WALL_LANDSCAPE="${XDG_PICTURES_DIR:-$HOME/Pictures}/walls/wall"
WALL_PORTRAIT="${XDG_PICTURES_DIR:-$HOME/Pictures}/walls/portrait_wall"

# Online Sources
ONLINE_WALL_LANDSCAPE="https://speyll.github.io/moire/feeds/landscape.txt"
ONLINE_WALL_PORTRAIT="https://speyll.github.io/moire/feeds/portrait.txt"
ONLINE_VID_LANDSCAPE="https://pastebin.com/raw/yHFpxMDB"
ONLINE_VID_PORTRAIT="https://pastebin.com/raw/NTVA8RMd"
