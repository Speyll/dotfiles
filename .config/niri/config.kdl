prefer-no-csd

// Includes
include "outputs.kdl"
include "rules.kdl"
include "layout.kdl"
include "keybinds.kdl"
//include "dms.kdl"
//include "noctalia.kdl"
include "barless.kdl"
include "fuzzel.kdl"

gestures {
    hot-corners {
        top-left
    }

    // Drag window against monitor edge to scroll tiling columns
    dnd-edge-view-scroll {
        trigger-width 50
    }

    // Drag window against monitor edge in overview to switch workspaces
    dnd-edge-workspace-switch {
        trigger-height 50
    }
}

input {
    keyboard {
        xkb {
            layout "us,fr"
            options "grp:rctrl_rshift_toggle,numpad:mac,compose:ralt"
        }
    }
    touchpad {
        tap
        accel-speed 0.2
        accel-profile "adaptive"
        scroll-method "two-finger"
    }
    mouse {
        accel-profile "flat"
    }
    tablet {
        map-to-output "DP-2"
    }
    touch {
        map-to-output "eDP-1"
    }
}

cursor {
    xcursor-theme "Kaela-Kovalskia-v2"
    xcursor-size 24
}

// Core spawns & globals
spawn-at-startup "autostart"
screenshot-path "~/Pictures/grim/%Y-%m-%d %H-%M-%S.png"

blur {
  passes 1
  offset 3.0
  noise 0.0
  saturation 1.0
}

hotkey-overlay {
    skip-at-startup
}
config-notification {
    disable-failed
}
debug {
    honor-xdg-activation-with-invalid-serial
}
