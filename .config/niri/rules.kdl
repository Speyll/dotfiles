window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id="^Alacritty$"
    default-column-width {
        proportion 0.5
    }
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="^chatterino$"
    match app-id="^com.chatterino.chatterino$"
    default-column-width {
            proportion 0.298
    }
}

window-rule {
    match app-id="^pcmanfm-qt$"
    match app-id="^dolphin$"
    match app-id="^librewolf$"
    match app-id="^firefox$"
    match app-id="^helium$"
    open-maximized true
    default-column-width {
            proportion 1.0;
    }
}

window-rule {
    match app-id="^librewolf$"
    opacity 1.0;
}


window-rule {
    match app-id="^firefox$" title="^Picture-in-Picture$"
    match app-id="^librewolf$" title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=16 y=16 relative-to="bottom-left"
}

window-rule {
    match app-id=r#"xdg-desktop-portal-.*"#
    match title=r#"(?i)dialog"#
    match title=r#"^Extension: "#
    match title=r#"^File Properties"#

    open-floating true
    default-column-width {
        proportion 0.65
    }
    default-window-height {
        proportion 0.35
    }
}

window-rule {
    match app-id=r#"^steam_app_.*$"#
    match app-id="gamescope"
    // Catch Wine/Proton games:
    match app-id=r#".*\.exe$"#

    // Catch shadPS4 by app-id (handles variants like shadps4-sdl)
    match app-id=r#"(?i)shadps4.*"#

    // Updated title regex to include shadps4
    match title=r#"(?i)emulator|yuzu|ryujinx|pcsx2|rpcs3|edin|dolphin|retroarch|shadps4"#

    variable-refresh-rate true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}
