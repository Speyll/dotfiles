#!/bin/sh

CONFIG="$HOME/.config/autostart.env"
[ -f "$CONFIG" ] && . "$CONFIG"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/autostart-wallpaper"
mkdir -p "$CACHE_DIR"

CACHE_LANDSCAPE="$CACHE_DIR/landscape"
CACHE_PORTRAIT="$CACHE_DIR/portrait"
CACHE_VID_LANDSCAPE="$CACHE_DIR/landscape_vid.mp4"
CACHE_VID_PORTRAIT="$CACHE_DIR/portrait_vid.mp4"

# --- Robust Native Orientation Fetch (Niri & Wlroots support) ---
get_orient() {
    _out=""

    # 1. Try Niri native output inspection
    if command -v niri >/dev/null 2>&1 && [ -n "$NIRI_SOCKET" ]; then
        _out=$(niri msg outputs 2>/dev/null | awk '
            /^Output "/ {
                line = $0;
                sub(/.*\(/, "", line);
                sub(/\).*/, "", line);
                name = line;
            }
            /Transform:/ {
                trans = $2;
                orient = (trans ~ /90|270/) ? "portrait" : "landscape";
                print name ":" orient;
            }
        ')
    fi

    # 2. Fallback to wlr-randr if running a wlroots compositor
    if [ -z "$_out" ] && command -v wlr-randr >/dev/null 2>&1; then
        _out=$(wlr-randr 2>/dev/null | awk '/^[A-Za-z0-9-]+/ {o=$1} /Transform:/ {print o ":" ($2 ~ /90|270/ ? "portrait" : "landscape")}')
    fi

    # 3. Final catch-all fallback
    if [ -z "$_out" ]; then
        echo "*:landscape"
    else
        echo "$_out"
    fi
}

fetch_url() {
    curl --connect-timeout 3 --max-time 6 -fsSL "$1" 2>/dev/null | shuf -n1 | tr -d '\r\n'
}

# --- Precision Cleanup (Per-monitor or Global) ---
clean_wallpaper() {
    target_mon="$1"
    if [ -n "$target_mon" ]; then
        # Kill only swaybg or mpvpaper running on this specific monitor output
        pkill -f "swaybg.*-o[[:space:]]*$target_mon" 2>/dev/null
        pkill -f "mpvpaper.*[[:space:]]$target_mon([[:space:]]|$)" 2>/dev/null
    else
        # Global fallback for full system startup
        killall -q swaybg mpvpaper
    fi
}

apply_swaybg() {
    landscape_img="$1"
    portrait_img="$2"
    target_mon="$3"

    get_orient | while IFS=: read -r out or; do
        [ -z "$out" ] && continue
        [ -n "$target_mon" ] && [ "$out" != "$target_mon" ] && continue

        img="$([ "$or" = "portrait" ] && echo "$portrait_img" || echo "$landscape_img")"
        setsid swaybg -o "$out" -i "$img" -m fill >/dev/null 2>&1 &
    done
}

apply_mpvpaper() {
    landscape_vid="$1"
    portrait_vid="$2"
    target_mon="$3"

    get_orient | while IFS=: read -r out or; do
        [ -z "$out" ] && continue
        [ -n "$target_mon" ] && [ "$out" != "$target_mon" ] && continue

        vid="$([ "$or" = "portrait" ] && echo "$portrait_vid" || echo "$landscape_vid")"
        setsid mpvpaper -vsp -o "--no-config --no-audio --no-pause --loop" "$out" "$vid" >/dev/null 2>&1 &
    done
}

# --- MANUAL CLI OVERRIDE (e.g., autostart-wallpaper file.mp4 [monitor]) ---
if [ "$#" -gt 0 ]; then
    TARGET="$1"
    MONITOR="$2"

    [ ! -f "$TARGET" ] && { echo "Error: File '$TARGET' not found." >&2; exit 1; }

    # Clean ONLY the targeted monitor (leaves other monitors completely untouched)
    clean_wallpaper "$MONITOR"

    case "$TARGET" in
        *.mp4|*.mkv|*.webm|*.avi|*.mov)
            cp "$TARGET" "$CACHE_VID_LANDSCAPE"
            apply_mpvpaper "$CACHE_VID_LANDSCAPE" "$CACHE_VID_PORTRAIT" "$MONITOR"
            ;;
        *)
            cp "$TARGET" "$CACHE_LANDSCAPE"
            apply_swaybg "$CACHE_LANDSCAPE" "$CACHE_LANDSCAPE" "$MONITOR"
            if [ "$THEME_MODE" = "auto" ]; then
                flavours generate dark "$CACHE_LANDSCAPE" && flavours apply generated 2>/dev/null &
            fi
            ;;
    esac
    exit 0
fi

# --- Handle Fixed Theme Globally if Set ---
if [ "$THEME_MODE" = "fixed" ]; then
    flavours apply "$THEME_NAME" >/dev/null 2>&1 &
fi

# --- Daemon / Startup Logic ---
clean_wallpaper # Global cleanup on full session boot

case "$MODE" in
    swaybg-random-online)
        apply_swaybg "$WALL_LANDSCAPE" "$WALL_PORTRAIT"
        if [ "$THEME_MODE" = "auto" ]; then
            flavours generate dark "$WALL_LANDSCAPE" && flavours apply generated 2>/dev/null &
        fi

        (
            landscape_url=$(fetch_url "$ONLINE_WALL_LANDSCAPE")
            portrait_url=$(fetch_url "$ONLINE_WALL_PORTRAIT")

            if [ -n "$landscape_url" ] && [ -n "$portrait_url" ]; then
                curl --connect-timeout 3 --max-time 10 -fsSL "$landscape_url" -o "$CACHE_LANDSCAPE" 2>/dev/null &
                p1=$!
                curl --connect-timeout 3 --max-time 10 -fsSL "$portrait_url" -o "$CACHE_PORTRAIT" 2>/dev/null &
                p2=$!
                wait "$p1" "$p2" 2>/dev/null

                if [ -s "$CACHE_LANDSCAPE" ] && [ -s "$CACHE_PORTRAIT" ]; then
                    clean_wallpaper
                    apply_swaybg "$CACHE_LANDSCAPE" "$CACHE_PORTRAIT"

                    if [ "$THEME_MODE" = "auto" ]; then
                        flavours generate dark "$CACHE_LANDSCAPE" && flavours apply generated 2>/dev/null
                    fi
                fi
            fi
        ) >/dev/null 2>&1 &
        ;;

    swaybg-random)
        w=$(find "${XDG_PICTURES_DIR:-$HOME/Pictures}/walls/" -maxdepth 1 \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | shuf -n1)
        vw=$(find "${XDG_PICTURES_DIR:-$HOME/Pictures}/walls/" -maxdepth 1 \( -name "vert-*.jpg" -o -name "vert-*.png" -o -name "vert-*.webp" \) 2>/dev/null | shuf -n1)
        target_landscape="${w:-$WALL_LANDSCAPE}"
        target_portrait="${vw:-$WALL_PORTRAIT}"

        [ -f "$target_landscape" ] && cp "$target_landscape" "$CACHE_LANDSCAPE"
        [ -f "$target_portrait" ] && cp "$target_portrait" "$CACHE_PORTRAIT"

        apply_swaybg "$CACHE_LANDSCAPE" "$CACHE_PORTRAIT"
        if [ "$THEME_MODE" = "auto" ]; then
            flavours generate dark "$CACHE_LANDSCAPE" && flavours apply generated 2>/dev/null &
        fi
        ;;

    mpvpaper-online)
        (
            landscape_vid_url=$(fetch_url "$ONLINE_VID_LANDSCAPE")
            portrait_vid_url=$(fetch_url "$ONLINE_VID_PORTRAIT")

            if [ -n "$landscape_vid_url" ]; then
                if command -v yt-dlp >/dev/null 2>&1; then
                    yt-dlp -o "$CACHE_VID_LANDSCAPE" --no-playlist "$landscape_vid_url" >/dev/null 2>&1
                else
                    curl --connect-timeout 5 --max-time 30 -fsSL "$landscape_vid_url" -o "$CACHE_VID_LANDSCAPE" 2>/dev/null
                fi
            fi

            if [ -n "$portrait_vid_url" ]; then
                if command -v yt-dlp >/dev/null 2>&1; then
                    yt-dlp -o "$CACHE_VID_PORTRAIT" --no-playlist "$portrait_vid_url" >/dev/null 2>&1
                else
                    curl --connect-timeout 5 --max-time 30 -fsSL "$portrait_vid_url" -o "$CACHE_VID_PORTRAIT" 2>/dev/null
                fi
            fi

            if [ -s "$CACHE_VID_LANDSCAPE" ]; then
                clean_wallpaper
                apply_mpvpaper "$CACHE_VID_LANDSCAPE" "$CACHE_VID_PORTRAIT"
            fi
        ) >/dev/null 2>&1 &

        if [ "$THEME_MODE" = "auto" ]; then
            flavours generate dark "$WALL_LANDSCAPE" && flavours apply generated 2>/dev/null &
        fi
        ;;

    *)
        apply_swaybg "$WALL_LANDSCAPE" "$WALL_PORTRAIT"
        if [ "$THEME_MODE" = "auto" ]; then
            flavours generate dark "$WALL_LANDSCAPE" && flavours apply generated 2>/dev/null &
        fi
        ;;
esac
