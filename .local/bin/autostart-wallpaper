#!/bin/sh

CONFIG="$HOME/.config/autostart.env"
[ -f "$CONFIG" ] && . "$CONFIG"

# Respect XDG Base Directory Specification for cache
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/autostart-wallpaper"
mkdir -p "$CACHE_DIR"
CACHE_WALL="$CACHE_DIR/wall.jpg"
CACHE_VWALL="$CACHE_DIR/vert_wall.jpg"

# --- Helper Functions ---
get_orient() {
    wlr-randr | awk '/^[A-Za-z0-9-]+/ {o=$1} /Transform:/ {print o ":" ($2 ~ /90|270/ ? "portrait" : "landscape")}'
}

fetch_url() {
    curl --connect-timeout 5 --max-time 10 -fsSL "$1" | shuf -n1 | tr -d '\r\n'
}

apply_swaybg() {
    get_orient | while IFS=: read -r o or; do
        img=$([ "$or" = "portrait" ] && echo "$2" || echo "$1")
        swaybg -o "$o" -i "$img" -m fill &
    done
}

apply_mpvpaper() {
    get_orient | while IFS=: read -r o or; do
        [ "$or" = "portrait" ] && fmt="bestvideo[width<=?1080]" vid="$2" || fmt="bestvideo[height<=?1080]" vid="$1"
        mpvpaper -vsp -o "no-audio pause=no --loop --ytdl-format=$fmt" "$o" "$vid" &
    done
}

# --- Aesthetics Logic ---
case "$MODE" in
    swaybg-random-online)
        # Apply local fallback immediately
        apply_swaybg "$DWALL" "$DVWALL"

        w_url=$(fetch_url "$P_WALL")
        vw_url=$(fetch_url "$P_VWALL")

        # Only proceed if we actually fetched URLs
        if [ -n "$w_url" ] && [ -n "$vw_url" ]; then
            # Overwrite the files directly in ~/.cache/
            curl --connect-timeout 5 --max-time 15 -fsSL "$w_url" -o "$CACHE_WALL" &
            curl --connect-timeout 5 --max-time 15 -fsSL "$vw_url" -o "$CACHE_VWALL" &
            wait

            # Safe handoff: Ensure files exist and are not empty (-s)
            if [ -s "$CACHE_WALL" ] && [ -s "$CACHE_VWALL" ]; then
                # Capture the process IDs of the fallback swaybg instances
                OLD_PIDS=$(pgrep -x swaybg)

                # Start the new wallpapers directly over the old ones
                apply_swaybg "$CACHE_WALL" "$CACHE_VWALL"

                # Give Wayland time to render the new layer, then silently kill the fallbacks
                if [ -n "$OLD_PIDS" ]; then
                    sleep 1
                    kill $OLD_PIDS 2>/dev/null
                fi
            fi
        fi
        ;;
    swaybg-random)
        w=$(find "$HOME/pictures/walls/" -maxdepth 1 -name "*.jpg" | shuf -n1)
        vw=$(find "$HOME/pictures/walls/" -maxdepth 1 -name "vert-*.jpg" | shuf -n1)
        apply_swaybg "${w:-$DWALL}" "${vw:-$DVWALL}"
        ;;
    mpvpaper-online)
        apply_mpvpaper "$(fetch_url "$P_VID")" "$(fetch_url "$P_VVID")"
        ;;
    *)
        apply_swaybg "$DWALL" "$DVWALL"
        ;;
esac

# --- Theme Apply ---
# Use the cached wallpaper if mode is online, otherwise fall back to local for theme generation
if [ "$THEME_MODE" = "auto" ]; then
    if [ "$MODE" = "swaybg-random-online" ] && [ -f "$CACHE_WALL" ]; then
        flavours generate dark "$CACHE_WALL" && flavours apply generated
    else
        flavours generate dark "$DWALL" && flavours apply generated
    fi
elif [ "$THEME_MODE" = "fixed" ]; then
    flavours apply "$THEME_NAME"
fi
