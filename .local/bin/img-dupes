#!/bin/bash

# --- CONFIGURATION ---
THRESHOLD="85%"         # 85-90% is ideal for "near-duplicates"
DB_FILE="fingerprints.db"
DEST_DIR="duplicates_backup"
mkdir -p "$DEST_DIR"

# --- HELPER FUNCTION ---
# Process a single set of duplicates stored in the ${files[@]} array
process_set() {
    if [ ${#files[@]} -gt 1 ]; then
        local original="${files[0]}"
        echo "Found set: $(basename "$original") has ${#files[@]} duplicates"

        # Start at index 1 to keep the original, move the rest
        for ((i=1; i<${#files[@]}; i++)); do
            local duplicate="${files[$i]}"
            if [ -f "$duplicate" ]; then
                mv -n "$duplicate" "$DEST_DIR/"
                echo "  [MOVED] -> $(basename "$duplicate")"
            fi
        done
    fi
}

# 1. INITIAL SCAN & DATABASE GENERATION
echo "Step 1: Refreshing fingerprint database ($DB_FILE)..."
find . -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" \) -print0 | \
    findimagedupes -0 -f "$DB_FILE" --rescan -

# 2. ACCURACY-FOCUSED COMPARISON
echo "Step 2: Comparing images at ${THRESHOLD} similarity..."

files=()
# -R ensures recursive search matches Step 1's depth
# -0 tells findimagedupes to output null-terminated sets
while IFS= read -r -d '' file; do
    if [[ -z "$file" ]]; then
        # An empty string means we hit the double-null (\0\0) end-of-set marker
        process_set
        files=() # Reset the array for the next set of duplicates
    else
        # Add the valid, space-inclusive filename to our current set
        files+=("$file")
    fi
done < <(findimagedupes -R -t "$THRESHOLD" -0 -f "$DB_FILE" .)

# Catch the very last set in case the output didn't have a trailing double-null
process_set

echo "Done! Check $DEST_DIR for moved files."
