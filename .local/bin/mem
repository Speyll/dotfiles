#!/bin/sh

ps -e -o rss= -o comm= | awk '
{
    rss = $1
    cmd = $2

    # Bracket kernel threads cleanly
    if (cmd ~ /^\[.*\]$/) cmd = "[" cmd "]"

    # Sum RSS per command name
    mem[cmd] += rss
}
END {
    for (cmd in mem) {
        mb = mem[cmd] / 1024
        if (mb >= 0.1) printf "%9.2f|%s\n", mb, cmd
    }
}' | sort -nr | awk -F'|' '
BEGIN {
    printf "%-20s %12s\n", "Process", "RAM Usage"
    printf "%-20s %12s\n", "--------------------", "------------"
}
{
    printf "%-20s %9.2f MB\n", $2, $1
    total += $1
}
END {
    printf "%-20s %12s\n", "--------------------", "------------"
    printf "%-20s %9.2f MB\n", "Total RAM Usage:", total
}'
