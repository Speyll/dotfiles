#!/bin/sh

# Source the configuration cleanly
CONFIG="$HOME/.config/autostart.env"
[ -f "$CONFIG" ] && . "$CONFIG" || exit 1

exec >> "$LOG" 2>&1
echo "=== Autostart: $(date) ==="

# 1. Wait for Compositor
timeout=20
while [ -z "$WAYLAND_DISPLAY" ] && [ "$timeout" -gt 0 ]; do
    sleep 0.5
    timeout=$((timeout - 1))
done

# 2. Efficient Cleanup (One system call instead of a shell loop)
killall -q flavours mpvpaper swaybg fnott wlsunset cliphist waybar mako hypridle openrgb sunshine lxqt-policykit-agent #pipewire wireplumber pipewire-pulse
sleep 1

# 3. Environment & Auth
if command -v gnome-keyring-daemon >/dev/null; then
    # eval inherently exports the required variables for this session cleanly
    eval "$(gnome-keyring-daemon --start --components=secrets)"
fi

# Polkit Agent Handoff
if ! pgrep -f "(pol|policy)kit.*agent" >/dev/null; then
    # 1. Direct binary execution for LXQt (no native systemd unit)
    if command -v lxqt-policykit-agent >/dev/null 2>&1; then
        lxqt-policykit-agent &

    # 2. Systemd path for agents that ship unit files
    elif [ -d /run/systemd/system ]; then
        systemctl --user start hyprpolkitagent.service 2>/dev/null || \
        systemctl --user start plasma-polkit-agent.service 2>/dev/null || \
        systemctl --user start polkit-gnome-authentication-agent-1.service 2>/dev/null

    # 3. Non-systemd fallback path
    else
        for agent in \
            /usr/libexec/hyprpolkitagent \
            /usr/lib/polkit-kde-authentication-agent-1 \
            /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
            /usr/libexec/polkit-gnome-authentication-agent-1; do
            if [ -f "$agent" ]; then
                "$agent" &
                break
            fi
        done
    fi
fi

# 4. Interface Settings
gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR"
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
command -v swaymsg >/dev/null && swaymsg seat seat0 xcursor_theme "$CURSOR"
dbus-update-activation-environment --all

# 5. Launch Fragments
~/.local/bin/autostart-services &
~/.local/bin/autostart-wallpaper &

# 6. Delayed Tasks
[ "$UPDATE_SCAN" = true ] && (sleep 10; "$HOME/.local/bin/updtscan") &
