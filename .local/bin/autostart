#!/bin/sh

# Source the configuration cleanly
CONFIG="$HOME/.config/autostart.env"
[ -f "$CONFIG" ] && . "$CONFIG" || exit 1

exec >> "$LOG" 2>&1
echo "=== Autostart: $(date) ==="

# 1. Wait for Compositor (Efficiently)
timeout=40 # 20 seconds at 0.5s intervals
while [ -z "$WAYLAND_DISPLAY" ] && [ "$timeout" -gt 0 ]; do
    sleep 0.5
    timeout=$((timeout - 1))
done

# 2. Clean Previous Session Daemons
killall -q flavours mpvpaper swaybg fnott wlsunset cliphist waybar mako hypridle openrgb sunshine lxqt-policykit-agent
sleep 0.5

# 3. Core Environment & Auth
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
    eval "$(gnome-keyring-daemon --start --components=secrets)"
    export SSH_AUTH_SOCK
fi

# 4. Interface Settings
gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR"
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
[ -n "$SWAYSOCK" ] && command -v swaymsg >/dev/null 2>&1 && swaymsg seat seat0 xcursor_theme "$CURSOR"

# 5. DBus Update
dbus-update-activation-environment --all
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

# 6. Polkit Agent Handoff (Prioritize systemd over detached binaries)
if ! pgrep -f "(pol|policy)kit.*agent" >/dev/null; then
    if [ -d /run/systemd/system ]; then
        systemctl --user start hyprpolkitagent.service 2>/dev/null || \
        systemctl --user start plasma-polkit-agent.service 2>/dev/null || \
        systemctl --user start polkit-gnome-authentication-agent-1.service 2>/dev/null
    elif command -v lxqt-policykit-agent >/dev/null 2>&1; then
        lxqt-policykit-agent &
    else
        for agent in \
            /usr/libexec/hyprpolkitagent \
            /usr/lib/polkit-kde-authentication-agent-1 \
            /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
            /usr/libexec/polkit-gnome-authentication-agent-1; do
            if [ -x "$agent" ]; then
                "$agent" &
                break
            fi
        done
    fi
fi

# 7. Launch Fragments
~/.local/bin/autostart-services &
~/.local/bin/autostart-wallpaper &

# 8. Delayed Tasks
[ "$UPDATE_SCAN" = true ] && (sleep 10; "$HOME/.local/bin/updtscan") &
