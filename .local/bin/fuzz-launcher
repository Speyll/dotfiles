#!/usr/bin/env bash
# Hyper-optimized Fuzzel Launcher Menu
# Stripped of heavy subshell overhead for instant execution

# --- Config ---
FONT="monospace:size=14"
ALIGN="center"
FUZZEL_CMD="fuzzel -d -f $FONT -a $ALIGN"

# --- Helper Functions ---
show_menu() {
    printf "%b" "$1" | $FUZZEL_CMD -w "$2" -l "$3"
}

launch() {
    if command -v "$1" >/dev/null 2>&1 || [ "$1" = "flatpak" ]; then
        exec "$@"
    else
        echo "Error: $1 not found" >&2
        exit 1
    fi
}

# --- Menu Handlers ---
handle_conn() {
    case "$(show_menu "󰈀 Network\n Bluetooth" 14 2)" in
        "󰈀 Network")   launch alacritty -T "Network Manager" -e nmtui ;;
        " Bluetooth") launch alacritty -T "Bluetooth Manager" -e bluetui ;;
    esac
}

handle_utils() {
    case "$(show_menu "💻 Streaming\n🔢 Calc\n⚙️ Run\n⌨️ Keyboard" 13 4)" in
        "💻 Streaming") exec_streaming ;;
        "🔢 Calc")      exec_calc ;;
        "⚙️ Run")       exec_run ;;
        "⌨️ Keyboard")  toggle_keyboard ;;
    esac
}

handle_power() {
    case "$(show_menu " Shutdown\n Suspend\n Reboot\n Lock" 11 4)" in
        " Shutdown") exec sudo poweroff ;;
        " Suspend")  exec sudo systemctl suspend ;;
        " Reboot")   exec sudo reboot ;;
        " Lock")     exec hyprlock ;;
    esac
}

# --- Utility Functions ---
exec_streaming() {
    platform=$(show_menu " Media\n Twitch" 9 2)
    [ -z "$platform" ] && exit 0

    if [ "$platform" = " Media" ]; then
        link=$(wl-paste)
    elif [ "$platform" = " Twitch" ]; then
        channel=$(fuzzel -d -p "Twitch channel: " -f "$FONT" -w 40 -l 0 -a "$ALIGN" </dev/null)
        [ -z "$channel" ] && exit 0
        link="https://twitch.tv/$channel"
    else
        exit 1
    fi

    case "$(show_menu " Video\n Audio" 9 2)" in
        " Video") exec mpv --pause=no "$link" ;;
        " Audio") exec foot -T "MPV Terminal" -e mpv --pause=no --no-video --volume=100 "$link" ;;
    esac
}

exec_calc() {
    last=""
    while :; do
        next=$(fuzzel -l 0 --dmenu -p "${last} " </dev/null)
        [ -z "$next" ] && exit 0
        if [ "$next" = "y" ]; then
            printf "%s" "$last" | wl-copy
            exit 0
        fi

        # Calculate, strip trailing zeros and dot if whole number
        last=$(echo "$last$next" | bc -l)
        case "$last" in
            *.*) last=${last%%0}; last=${last%.} ;;
        esac
    done
}

exec_run() {
    # compgen -c instantly grabs all binaries in $PATH for a true dmenu_run experience
    cmd=$(compgen -c | sort -u | $FUZZEL_CMD -p "Run: " -l 15)

    # Intentionally leaving $cmd unquoted here so you can pass arguments (e.g., "killall waybar")
    [ -n "$cmd" ] && exec $cmd
}

toggle_keyboard() {
    if pkill -x wvkbd-mobintl; then
        exit 0
    else
        exec wvkbd-mobintl -H 50 -R 5 --bg "#282828" --fg "#ffffff" --fn "monospace 12" --alpha 200
    fi
}

# --- Main Logic Pipeline ---
case "$(show_menu "🖥️ Terminal\n🗃️ Explorer\n📺 Youtube\n🌐 Network\n⚙️ Utils\n🔌 Power" 13 6)" in
    "🖥️ Terminal") launch alacritty ;;
    "🗃️ Explorer") launch pcmanfm-qt ;;
    "📺 Youtube") launch yt-search ;;
    "🌐 Network") handle_conn ;;
    "⚙️ Utils") handle_utils ;;
    "🔌 Power") handle_power ;;
esac
