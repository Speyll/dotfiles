#!/bin/sh
# Unified Wayland compositor launcher

# --- Parse Arguments (0 forks, pure POSIX) ---
[ -z "$1" ] || [ "${1#-}" != "$1" ] && {
  echo "Usage: ${0##*/} <compositor>" >&2
  exit 1
}
COMPOSITOR="$1"

if ! command -v "$COMPOSITOR" >/dev/null 2>&1; then
  echo "Error: Compositor '$COMPOSITOR' not found in PATH." >&2
  exit 1
fi

# --- Dynamically set XDG_CURRENT_DESKTOP based on the compositor ---
case "$COMPOSITOR" in
    *niri*)     XDG_CURRENT_DESKTOP="niri" ;;
    *hyprland*) XDG_CURRENT_DESKTOP="Hyprland" ;;
    *sway*)     XDG_CURRENT_DESKTOP="sway" ;;
    *)          XDG_CURRENT_DESKTOP="${COMPOSITOR%-session}" ;;
esac

# --- Setup Logging ---
mkdir -p "$HOME/.cache"
LOGFILE="$HOME/.cache/wsession-errors"
echo "=== $COMPOSITOR session started: $(date) ===" >> "$LOGFILE"
exec >> "$LOGFILE" 2>&1

# --- Environment Variables ---
export XDG_SESSION_TYPE="wayland"
export XDG_CURRENT_DESKTOP

export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER="wayland,x11"
export CLUTTER_BACKEND="wayland"
export QT_QPA_PLATFORMTHEME="qt6ct"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GTK_USE_PORTAL=1
export NO_AT_BRIDGE=1

export XCURSOR_THEME="Kaela-Kovalskia-v2"
export XCURSOR_SIZE=24
export XKB_DEFAULT_LAYOUT="us,fr"
export XKB_DEFAULT_OPTIONS="grp:rctrl_rshift_toggle"

export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"

# --- Push Static Environment to Systemd & D-Bus BEFORE starting compositor ---
dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

# --- Launch Compositor ---
exec "$COMPOSITOR"
