#!/bin/sh

# 1. Date & Time (Requires 1 fork: date)
DATETIME=$(date +"%A, %d %b | %H:%M")

BODY=""

# 2. Battery (Requires 0 forks: uses shell built-in 'read')
# Safely find the first battery directory without external commands like 'ls' or 'find'
set -- /sys/class/power_supply/BAT*

if [ -f "$1/capacity" ]; then
    # Using 'read' avoids spawning a 'cat' subshell, making this virtually zero-cost
    read -r BAT_PCT < "$1/capacity"
    read -r BAT_STAT < "$1/status"

    case "$BAT_STAT" in
        "Charging") BAT_ICON="⚡" ;; # Changed from 🪫 (low battery) to ⚡
        "Full")     BAT_ICON="🔌" ;;
        *)          BAT_ICON="🔋" ;;
    esac
    BODY="${BAT_ICON}  ${BAT_PCT}%"
fi

# 3. Actionable Output Dispatch (Requires 1 fork: notify-send)
# The ${BODY:+"$BODY"} trick only passes the body argument if BODY is not empty.
notify-send \
    -a "System Status" \
    -h string:x-canonical-private-synchronous:status-popup \
    -t 0 \
    "${DATETIME}" \
    ${BODY:+"$BODY"}
