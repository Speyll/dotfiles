#!/bin/sh

CONFIG="$HOME/.config/autostart.env"
[ -f "$CONFIG" ] && . "$CONFIG"

foot --server &
wlsunset -l 36.7 -L 3.08 &
fnott &
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &
hypridle &
#sunshine &

if [ "$WAYBAR_STYLE" != "none" ]; then
    waybar -c "$HOME/.config/waybar/$WAYBAR_STYLE-config" -s "$HOME/.config/waybar/style.css" &
fi

if command -v openrgb >/dev/null 2>&1; then
    openrgb --server -p pureWhite &
fi

# --- Audio Stack (Systemd-aware / Void Linux fallback) ---
if [ "$AUDIO" = true ]; then
    # If systemd user session is active, ensure units are started; otherwise fallback to manual binary execution
    if [ -d /run/systemd/system ] && systemctl --user --version >/dev/null 2>&1; then
        systemctl --user start pipewire wireplumber pipewire-pulse 2>/dev/null
    else
        # Void Linux / Non-systemd fallback path
        pgrep -x pipewire >/dev/null || pipewire &
        sleep 0.5
        pgrep -x wireplumber >/dev/null || wireplumber &
        pgrep -x pipewire-pulse >/dev/null || pipewire-pulse &
    fi
fi
