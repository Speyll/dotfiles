#!/bin/sh
# List files that exist (top level) in <dir1> but not in <dir2>.

if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: $0 <dir1> <dir2>" >&2
    exit 1
fi

dir1="$1"
dir2="$2"

if [ ! -d "$dir1" ] || [ ! -d "$dir2" ]; then
    echo "Error: One or both directories do not exist." >&2
    exit 1
fi

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM

list() { find "$1" -maxdepth 1 -type f -printf '%f\n' | sort; }

list "$dir1" > "$tmp/a"
list "$dir2" > "$tmp/b"
comm -23 "$tmp/a" "$tmp/b"
